---
import BaseLayout from "./BaseLayout.astro";

const { entry, related = [], headings = [], readingTime } = Astro.props;
const { data } = entry;

const dateFmt = (d: Date) =>
  new Intl.DateTimeFormat("nl-NL", { day: "numeric", month: "long", year: "numeric" }).format(d);

const toc = (headings || []).filter((h: any) => h.depth === 2);

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate?.toISOString(),
  dateModified: (data.updatedDate || data.pubDate)?.toISOString(),
  author: { "@type": "Organization", name: data.author || "deOpruimgids.nl" },
  publisher: { "@type": "Organization", name: "deOpruimgids.nl" },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<BaseLayout
  title={data.metaTitle || data.title}
  description={data.description}
  image={data.heroImage}
  type="article"
  publishedTime={data.pubDate?.toISOString()}
  modifiedTime={data.updatedDate?.toISOString()}
  schema={schema}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Kruimelpad">
      <a href="/">Home</a>
      <span class="sep">›</span>
      <a href="/blog/">Blog</a>
      <span class="sep">›</span>
      <span>{data.title}</span>
    </nav>
  </div>

  <article>
    <header class="article-header wrap-narrow">
      <h1>{data.title}</h1>
      <div class="article-meta">
        {data.author && <span>Door {data.author}</span>}
        <span class="dot">•</span>
        <time datetime={data.pubDate?.toISOString()}>{dateFmt(data.pubDate)}</time>
        {readingTime && (
          <>
            <span class="dot">•</span>
            <span>{readingTime} min lezen</span>
          </>
        )}
        {data.updatedDate && (
          <>
            <span class="dot">•</span>
            <span>bijgewerkt {dateFmt(data.updatedDate)}</span>
          </>
        )}
      </div>
    </header>

    {data.heroImage && (
      <div class="wrap" style="margin-bottom:2.5rem">
        <img
          src={data.heroImage}
          alt=""
          style="border-radius:var(--radius-lg);width:100%;max-height:440px;object-fit:cover"
        />
      </div>
    )}

    <div class="wrap">
      <div class="article-layout">
        <div class="prose">
          <slot />
        </div>

        {toc.length > 2 && (
          <nav class="toc" aria-label="Inhoudsopgave">
            <h2>Inhoud</h2>
            <ol>
              {toc.map((h: any) => (
                <li><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ol>
          </nav>
        )}
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section section-sunken" style="margin-top:4rem">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2>Meer uit de blog</h2>
            <p>Andere artikelen die je misschien interessant vindt.</p>
          </div>
          <a class="btn btn-quiet btn-sm" href="/blog/">Alle artikelen</a>
        </div>
        <div class="grid grid-3">
          {related.map((p: any) => (
            <article class="card">
              {p.data.heroImage && (
                <div class="card-media">
                  <img src={p.data.heroImage} alt="" loading="lazy" />
                </div>
              )}
              <div class="card-body">
                <h3><a href={`/${p.id}/`}>{p.data.title}</a></h3>
                <p>{p.data.description}</p>
                <div class="meta">
                  <time datetime={p.data.pubDate?.toISOString()}>{dateFmt(p.data.pubDate)}</time>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a")];
  if (links.length) {
    const map = new Map<string, HTMLAnchorElement>();
    for (const a of links) map.set(decodeURIComponent(a.hash.slice(1)), a);
    const heads = [...document.querySelectorAll<HTMLElement>(".prose h2[id]")];
    const obs = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((l) => l.classList.remove("active"));
          map.get(e.target.id)?.classList.add("active");
        }
      },
      { rootMargin: "-90px 0px -70% 0px", threshold: 0 }
    );
    heads.forEach((h) => obs.observe(h));
  }
</script>
