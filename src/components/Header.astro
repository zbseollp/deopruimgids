---
import { getCollection } from 'astro:content';

const { pathname } = Astro.url;

// Dropdowngroepen zoals in het originele WordPress-menu (Wonen / Kantoor /
// Elektronica). De items komen uit de products-collectie, zodat het menu
// meegroeit zodra er pagina's bij komen.
const products = await getCollection('products');
const order = ['Wonen', 'Kantoor', 'Elektronica'];

const groups = order
  .map((cat) => ({
    label: cat,
    items: products
      .filter((p) => p.data.category === cat)
      .sort((a, b) => a.data.label.localeCompare(b.data.label, 'nl')),
  }))
  .filter((g) => g.items.length > 0);

const plain = [
  { href: '/blog/', label: 'Blog' },
  { href: '/contact/', label: 'Contact' },
  { href: '/over-ons/', label: 'Over ons' },
];

const isCurrent = (href: string) => pathname === href;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="deOpruimgids.nl — naar de homepage">
      <img src="/logo.svg" alt="deOpruimgids.nl" width="190" height="24" />
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Menu openen"
    >
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="7" x2="21" y2="7"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="17" x2="21" y2="17"></line>
      </svg>
    </button>

    <nav class="nav" id="site-nav" aria-label="Hoofdmenu">
      <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Home</a>

      {groups.map((g) => (
        <div class="has-dropdown">
          <button type="button" class="dropdown-toggle" aria-expanded="false">
            {g.label}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="dropdown">
            {g.items.map((p) => (
              <a href={`/${p.id}/`}>{p.data.label}</a>
            ))}
          </div>
        </div>
      ))}

      {plain.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');

  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.setAttribute('aria-label', open ? 'Menu sluiten' : 'Menu openen');
  });

  const dropdowns = [...document.querySelectorAll<HTMLElement>('.has-dropdown')];

  function closeAll(except?: HTMLElement) {
    for (const d of dropdowns) {
      if (d === except) continue;
      d.classList.remove('open');
      d.querySelector('.dropdown-toggle')?.setAttribute('aria-expanded', 'false');
    }
  }

  for (const d of dropdowns) {
    const btn = d.querySelector<HTMLButtonElement>('.dropdown-toggle');
    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = d.classList.toggle('open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      closeAll(d);
    });
  }

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.has-dropdown')) closeAll();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (dropdowns.some((d) => d.classList.contains('open'))) {
      closeAll();
      return;
    }
    if (nav?.classList.contains('open')) {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.focus();
    }
  });
</script>
