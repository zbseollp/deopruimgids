---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <div class="footer-logo">
          <img src="/logo.svg" alt="deOpruimgids.nl" width="190" height="24" />
        </div>
        <p>
          Onafhankelijke adviezen over opruimen en schoonmaken. Wij vergelijken de
          beste producten voor een opgeruimd huis, een nette werkplek en een
          duurzaam ingerichte woning.
        </p>
      </div>

      <div>
        <h4>Over deze site</h4>
        <ul>
          <li><a href="/over-ons/">Over ons</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/sitemap/">Sitemap</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} deOpruimgids.nl — Alle rechten voorbehouden.</span>
      <span>Opruim- en schoonmaakproducten vergeleken.</span>
    </div>
  </div>
</footer>
