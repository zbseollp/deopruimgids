---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '../layouts/BlogPostLayout.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');

  const sorted = [...blogEntries].sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      related: sorted.filter((p) => p.id !== entry.id).slice(0, 3),
    },
  }));
}

const { entry, related } = Astro.props;
const { Content, headings } = await render(entry);

// ruwe leestijd op basis van de body (200 woorden per minuut)
const readingTime = entry.body
  ? Math.max(1, Math.round(entry.body.split(/[^A-Za-z0-9]+/).filter(Boolean).length / 200))
  : undefined;
---

<BlogPostLayout entry={entry} related={related} headings={headings} readingTime={readingTime}>
  <Content />
</BlogPostLayout>
