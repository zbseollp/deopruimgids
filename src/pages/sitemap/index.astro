---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const products = (await getCollection('products')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'nl')
);

const pages = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Blog' },
  { href: '/over-ons/', label: 'Over ons' },
  { href: '/contact/', label: 'Contact' },
];
---

<BaseLayout
  title="Sitemap — deOpruimgids.nl"
  description="Een overzicht van alle pagina's en artikelen op deOpruimgids.nl."
>
  <section class="hero hero-compact">
    <div class="wrap lead">
      <h1>Sitemap</h1>
      <p>Een compleet overzicht van alle pagina&rsquo;s en artikelen op deze website.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap-narrow prose">
      <h2>Pagina&rsquo;s</h2>
      <ul>
        {pages.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
      </ul>

      <h2>Artikelen ({posts.length})</h2>
      <ul>
        {posts.map((p) => <li><a href={`/${p.id}/`}>{p.data.title}</a></li>)}
      </ul>

      <h2>Productvergelijkingen ({products.length})</h2>
      <p style="color:var(--text-muted)">Deze pagina&rsquo;s zijn nog in voorbereiding.</p>
      <ul>
        {products.map((p) => <li><a href={`/${p.id}/`}>{p.data.title}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
