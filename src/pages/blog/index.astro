---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFmt = (d: Date) =>
  new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
---

<BaseLayout
  title="Blog — deOpruimgids.nl"
  description="Artikelen, tips en achtergronden over opruimen, schoonmaken en het inrichten van een opgeruimd huis."
>
  <section class="hero hero-compact">
    <div class="wrap lead">
      <div class="eyebrow-line">Redactie</div>
      <h1>Blog</h1>
      <p class="sub">
        Artikelen, tips en achtergronden over opruimen en schoonmaken. Van
        praktische opruimtips tot verhalen die je aandacht vasthouden &mdash; hier
        vind je alles wat we schrijven.
      </p>
    </div>
  </section>

  <div class="wrap">
    <nav class="crumbs" aria-label="Kruimelpad">
      <a href="/">Home</a>
      <span class="sep">›</span>
      <span>Blog</span>
    </nav>
  </div>

  <section class="section">
    <div class="wrap">
      <div class="filter-bar" data-post-filter>
        <label class="filter-input">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
          </svg>
          <input type="search" placeholder="Zoek in artikelen…" aria-label="Zoek in artikelen" />
        </label>
        <span class="filter-count" data-count>{posts.length} artikelen</span>
      </div>

      <div class="grid grid-3" data-filter-list>
        {posts.map((post) => (
          <article
            class="card"
            data-name={`${post.data.title} ${post.data.description}`.toLowerCase()}
          >
            {post.data.heroImage && (
              <div class="card-media">
                <img src={post.data.heroImage} alt="" loading="lazy" />
              </div>
            )}
            <div class="card-body">
              <h3><a href={`/${post.id}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <div class="meta">
                <time datetime={post.data.pubDate.toISOString()}>{dateFmt(post.data.pubDate)}</time>
              </div>
            </div>
          </article>
        ))}
      </div>

      <p class="empty-state" data-empty hidden>
        Geen artikelen gevonden die aan je zoekopdracht voldoen.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const bar = document.querySelector<HTMLElement>('[data-post-filter]');
  if (bar) {
    const input = bar.querySelector<HTMLInputElement>('input');
    const countEl = bar.querySelector<HTMLElement>('[data-count]');
    const empty = document.querySelector<HTMLElement>('[data-empty]');
    const items = [...document.querySelectorAll<HTMLElement>('[data-filter-list] [data-name]')];
    const total = items.length;

    input?.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      for (const el of items) {
        const hit = !q || (el.dataset.name || '').includes(q);
        el.style.display = hit ? '' : 'none';
        if (hit) shown++;
      }
      if (countEl) {
        countEl.textContent = q ? `${shown} van ${total} artikelen` : `${total} artikelen`;
      }
      if (empty) empty.hidden = shown !== 0;
    });
  }
</script>
