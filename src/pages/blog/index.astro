---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { PAGE_SIZE } from '../../lib/pagination';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));
const posts = allPosts.slice(0, PAGE_SIZE);
---

<BaseLayout
  title="Blog — deOpruimgids.nl"
  description="Artikelen, tips en achtergronden over opruimen, schoonmaken en het inrichten van een opgeruimd huis."
>
  <section class="hero hero-compact">
    <div class="wrap lead">
      <div class="eyebrow-line">Redactie</div>
      <h1>Blog</h1>
      <p class="sub">
        Artikelen, tips en achtergronden over opruimen en schoonmaken. Van
        praktische opruimtips tot verhalen die je aandacht vasthouden &mdash; hier
        vind je alles wat we schrijven.
      </p>
    </div>
  </section>

  <div class="wrap">
    <nav class="crumbs" aria-label="Kruimelpad">
      <a href="/">Home</a>
      <span class="sep">›</span>
      <span>Blog</span>
    </nav>
  </div>

  <section class="section">
    <div class="wrap">
      <PostList
        posts={posts}
        allPosts={allPosts}
        page={1}
        totalPages={totalPages}
        total={allPosts.length}
        basePath="/blog"
      />
    </div>
  </section>
</BaseLayout>
