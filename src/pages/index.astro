---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = posts[0];
const recent = posts.slice(1, 7);

const dateFmt = (d: Date) =>
  new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'deOpruimgids.nl',
  url: 'https://deopruimgids.nl/',
  description:
    'Wij vergelijken de beste producten in het teken van opruimen en schoonmaken.',
};
---

<BaseLayout
  title="DeOpruimGids.nl - Vergelijk opruim- en schoonmaakproducten"
  description="Op onze website vergelijken wij de beste producten in het teken van opruimen en schoonmaken. Bekijk onze reviews en koop de beste, meest goedkope producten."
  schema={schema}
>
  <section class="hero">
    <div class="wrap lead">
      <h1>Een opgeruimd huis, zonder gedoe</h1>
      <p class="sub">
        Een ruimte of woning opgeruimd houden kan vrij lastig zijn. Het is al snel
        een rommeltje, zelfs als je er alles aan doet om het opgeruimd te houden.
        Gelukkig kun je altijd van de beste opruimproducten gebruikmaken &mdash; wij
        zoeken ze voor je uit.
      </p>
      <div class="hero-actions">
        <a class="btn" href="/blog/">Lees onze artikelen</a>
        <a class="btn btn-ghost" href="#uitgelegd">Hoe wij werken</a>
      </div>

      <div class="stat-row">
        <div class="stat">
          <strong>{posts.length}</strong>
          <span>artikelen</span>
        </div>
        <div class="stat">
          <strong>Onafhankelijk</strong>
          <span>advies van onze redactie</span>
        </div>
      </div>
    </div>
  </section>

  {featured && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2>Uitgelicht</h2>
            <p>Het nieuwste artikel van onze redactie.</p>
          </div>
        </div>

        <article class="card">
          <div class="card-body" style="padding:1.9rem 2rem 2rem">
            <span class="tag">Nieuwste</span>
            <h3 style="font-size:clamp(1.35rem,2.6vw,1.9rem);margin:.7rem 0 .6rem">
              <a href={`/${featured.id}/`}>{featured.data.title}</a>
            </h3>
            <p style="font-size:1.02rem;max-width:70ch">{featured.data.description}</p>
            <div class="meta">
              <time datetime={featured.data.pubDate.toISOString()}>
                {dateFmt(featured.data.pubDate)}
              </time>
            </div>
          </div>
        </article>
      </div>
    </section>
  )}

  <section class="section section-sunken">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>Nieuwste artikelen</h2>
          <p>Bekijk hieronder de meest recente artikelen van onze redactie.</p>
        </div>
        <a class="btn btn-quiet btn-sm" href="/blog/">Alle {posts.length} artikelen</a>
      </div>

      <div class="grid grid-3">
        {recent.map((post) => (
          <article class="card">
            {post.data.heroImage && (
              <div class="card-media">
                <img src={post.data.heroImage} alt="" loading="lazy" />
              </div>
            )}
            <div class="card-body">
              <h3><a href={`/${post.id}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <div class="meta">
                <time datetime={post.data.pubDate.toISOString()}>{dateFmt(post.data.pubDate)}</time>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="uitgelegd">
    <div class="wrap-narrow prose">
      <h2 style="margin-top:0">De beste opruimproducten</h2>
      <p>
        Wil je je woning graag vakkundig opruimen? De eerste stap is het checken van
        deze website. Op deze website vind je namelijk de beste adviezen over de beste
        opruimproducten van dit moment. Door voor deze producten te kiezen, weet je
        zeker dat je je woning snel, vakkundig en effici&euml;nt op kunt ruimen. Veel
        van deze opruimproducten zijn ook nog duurzaam. Dat houdt in dat je in principe
        jarenlang van deze opruimproducten gebruik kunt maken.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>Een vraag over opruimen?</h2>
          <p>Laat het ons weten &mdash; we denken graag met je mee.</p>
        </div>
        <a class="btn" href="/contact/">Neem contact op</a>
      </div>
    </div>
  </section>
</BaseLayout>
